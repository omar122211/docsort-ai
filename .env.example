# Copy this file to .env and fill in your key. .env is git-ignored — never commit it.
# Free key (no card needed): https://aistudio.google.com/apikey
# Without a key, documents are still sorted (local model); only field extraction is off.
GEMINI_API_KEY=

# Optional overrides
# VISION_MODEL=gemini-3.5-flash-lite
# FALLBACK_VISION_MODEL=gemini-3.8-flash
# MIN_CONFIDENCE=0.55
